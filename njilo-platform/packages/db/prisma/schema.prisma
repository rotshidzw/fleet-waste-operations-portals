generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  MANAGER
  OPS
  HR
  READ_ONLY
}

enum OpportunityStage {
  QUALIFY
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum VacancyStatus {
  ACTIVE
  CLOSED
}

enum WorkflowArea {
  HR_ONBOARDING
  HR_PERFORMANCE
  HR_LEAVE
  HR_TRAINING
  HR_POLICIES
  ADMIN_ACCESS
  ADMIN_SECURITY
  ADMIN_BUDGET
  ADMIN_VENDOR
  ADMIN_COMMS
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

enum DocumentCategory {
  HR
  CONTRACTS
  COMPLIANCE
  FINANCE
  FLEET
  SAFETY
}

enum DocumentStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum JobStatus {
  REQUESTED
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ComplianceType {
  DRIVER_LICENSE
  VEHICLE_LICENSE
  COF
  SAFETY_INCIDENT
  AUDIT
}

enum AssetType {
  VEHICLE
  PLANT
  EQUIPMENT
}

enum AssetStatus {
  ACTIVE
  IN_MAINTENANCE
  DECOMMISSIONED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ProcurementStatus {
  REQUESTED
  APPROVED
  ORDERED
  FULFILLED
  DECLINED
}

enum InvoiceStatus {
  SUBMITTED
  APPROVED
  SENT
  PAID
  REJECTED
}

enum ContractStatus {
  ACTIVE
  PENDING_RENEWAL
  EXPIRED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum LeadDepartment {
  SALES
  OPS
  HR
  SUPPORT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  accounts  Account[]

  @@index([roleId])
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
}

model Lead {
  id          String         @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  companyName String?
  department  LeadDepartment
  message     String?
  source      String
  createdAt   DateTime       @default(now())

  @@index([department])
  @@index([createdAt])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String
  employees Employee[]
  createdAt DateTime @default(now())

  @@index([code])
}

model JobTitle {
  id        String   @id @default(cuid())
  name      String
  grade     String?
  employees Employee[]
  createdAt DateTime @default(now())
}

model Employee {
  id               String         @id @default(cuid())
  fullName         String
  email            String         @unique
  phone            String?
  extension        String?
  emergencyContact String?
  status           EmployeeStatus
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
  jobTitleId       String
  jobTitle         JobTitle       @relation(fields: [jobTitleId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([departmentId])
  @@index([status])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  website     String?
  contacts    Contact[]
  opportunities Opportunity[]
  createdAt   DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String
  phone     String?
  title     String?
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Opportunity {
  id        String            @id @default(cuid())
  name      String
  value     Float
  stage     OpportunityStage
  companyId String?
  company   Company?          @relation(fields: [companyId], references: [id])
  activities Activity[]
  createdAt DateTime          @default(now())

  @@index([stage])
}

model Document {
  id        String          @id @default(cuid())
  title     String
  category  DocumentCategory
  status    DocumentStatus
  version   String
  owner     String
  expiresAt DateTime?
  fileRef   String?
  createdAt DateTime        @default(now())

  @@index([category])
  @@index([status])
}

model Activity {
  id           String   @id @default(cuid())
  opportunityId String?
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])
  note         String
  createdAt    DateTime @default(now())
}

model Vehicle {
  id           String   @id @default(cuid())
  vin          String   @unique
  make         String
  model        String
  year         Int
  status       String
  maintenanceTickets MaintenanceTicket[]
  fuelLogs           FuelLog[]
  trafficFines       TrafficFine[]
  createdAt    DateTime @default(now())
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  licenseNo String
  status    String
  createdAt DateTime @default(now())
}

model MaintenanceTicket {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  issue     String
  status    String
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model FuelLog {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  liters    Float
  cost      Float
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model TrafficFine {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  amount    Float
  status    String
  issuedAt  DateTime

  @@index([vehicleId])
}

model TrackingProvider {
  id         String   @id @default(cuid())
  providerName String
  apiKey     String
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
}

model WasteJob {
  id        String   @id @default(cuid())
  jobNumber String   @unique
  status    String
  site      String
  scheduledAt DateTime
  createdAt DateTime @default(now())
}

model WorkOrder {
  id            String   @id @default(cuid())
  jobNumber     String   @unique
  client        String
  location      String
  assignedAsset String?
  assignedTeam  String?
  status        JobStatus
  scheduledFor  DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
}

model Equipment {
  id        String   @id @default(cuid())
  name      String
  serialNo  String?
  status    String
  createdAt DateTime @default(now())
}

model ComplianceNote {
  id        String   @id @default(cuid())
  note      String
  createdAt DateTime @default(now())
}

model ComplianceRecord {
  id        String         @id @default(cuid())
  type      ComplianceType
  reference String
  status    String
  expiresAt DateTime?
  owner     String
  notes     String?
  createdAt DateTime       @default(now())

  @@index([type])
  @@index([status])
}

model Testimonial {
  id        String   @id @default(cuid())
  client    String
  quote     String
  role      String?
  createdAt DateTime @default(now())
}

model Asset {
  id                 String      @id @default(cuid())
  assetTag           String      @unique
  name               String
  type               AssetType
  trackingId         String?
  serviceIntervalDays Int?
  status             AssetStatus
  createdAt          DateTime    @default(now())

  @@index([status])
  @@index([type])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  sortOrder Int
  createdAt DateTime @default(now())
}

model Publication {
  id        String   @id @default(cuid())
  title     String
  summary   String
  body      String
  pdfUrl    String?
  createdAt DateTime @default(now())
}

model Event {
  id        String   @id @default(cuid())
  title     String
  summary   String
  eventDate DateTime
  createdAt DateTime @default(now())
}

model WorkflowItem {
  id        String       @id @default(cuid())
  area      WorkflowArea
  title     String
  owner     String
  status    String
  details   String
  dueDate   DateTime?
  createdAt DateTime     @default(now())

  @@index([area])
  @@index([status])
}

model MediaItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  createdAt DateTime @default(now())
}

model VideoItem {
  id        String   @id @default(cuid())
  title     String
  videoUrl  String
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  summary   String
  body      String
  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  summary   String
  body      String
  heroImage String
  createdAt DateTime @default(now())

  @@index([category])
}

model HelpdeskTicket {
  id          String        @id @default(cuid())
  subject     String
  category    String
  priority    TicketPriority
  status      TicketStatus
  requester   String
  assignedTo  String?
  details     String?
  createdAt   DateTime      @default(now())

  @@index([status])
  @@index([priority])
}

model ProcurementRequest {
  id         String            @id @default(cuid())
  item       String
  quantity   Int
  requester  String
  department String
  status     ProcurementStatus
  notes      String?
  createdAt  DateTime          @default(now())

  @@index([status])
}

model InvoiceRequest {
  id         String        @id @default(cuid())
  client     String
  amount     Float
  status     InvoiceStatus
  requester  String
  details    String?
  createdAt  DateTime      @default(now())

  @@index([status])
}

model Client {
  id            String         @id @default(cuid())
  name          String
  contractStart DateTime?
  contractEnd   DateTime?
  serviceScope  String?
  status        ContractStatus
  contracts     Contract[]
  createdAt     DateTime       @default(now())
}

model Contract {
  id          String         @id @default(cuid())
  name        String
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  startDate   DateTime
  endDate     DateTime
  status      ContractStatus
  documentRef String?
  createdAt   DateTime       @default(now())

  @@index([clientId])
  @@index([status])
}

model Incident {
  id              String           @id @default(cuid())
  incidentType    String
  severity        IncidentSeverity
  location        String
  reportedBy      String
  rootCause       String?
  correctiveAction String?
  status          String
  createdAt       DateTime         @default(now())

  @@index([severity])
  @@index([status])
}

model MaintenanceSchedule {
  id             String            @id @default(cuid())
  assetId        String?
  serviceType    String
  nextServiceAt  DateTime
  status         MaintenanceStatus
  notes          String?
  createdAt      DateTime          @default(now())

  @@index([status])
}

model ReportExport {
  id        String   @id @default(cuid())
  title     String
  period    String
  status    String
  createdAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String  @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Vacancy {
  id        String        @id @default(cuid())
  title     String
  location  String
  status    VacancyStatus
  summary   String
  applications Application[]
  createdAt DateTime @default(now())
}

model Application {
  id         String   @id @default(cuid())
  vacancyId  String
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id])
  fullName   String
  email      String
  resumeUrl  String?
  createdAt  DateTime @default(now())

  @@index([vacancyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
