FROM node:20-bullseye-slim AS builder

WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/intranet/package.json apps/intranet/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/ui/package.json packages/ui/
RUN npm install --workspaces --include-workspace-root

COPY . .
RUN npm --workspace packages/db run generate
WORKDIR /app/apps/intranet
RUN npm run build

FROM node:20-bullseye-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/apps/intranet/.next/standalone ./
COPY --from=builder /app/apps/intranet/.next/static ./apps/intranet/.next/static
COPY --from=builder /app/apps/intranet/public ./apps/intranet/public

EXPOSE 3001
CMD ["node", "server.js"]
